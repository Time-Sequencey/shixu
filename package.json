{
  "name": "shixu",
  "version": "1.0.1",
  "private": true,
  "description": "时叙：本地 PDF 中英对照阅读助手，支持电子数据手册表格翻译、OCR、DeepSeek API 与 Windows 便携运行",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "node scripts/start.cjs",
    "test": "node checks/layout.mjs && node checks/deepseek-batches.cjs",
    "selfcheck": "node scripts/selfcheck.cjs",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.6.205",
    "tesseract.js": "7.0.0"
  }
}
